# for tmux v3.2 or later
# github https://github.com/tmux/tmux
# manual page https://man.openbsd.org/tmux

# 即時適用
# $ tmux source ~/.tmux.conf

# mouse は v3.8 以降default on (v3.7 以前でマウスを使いたい場合は以下コメントを外す)
# set -g mouse on

# prefixキーをC-jに変更
set -g prefix C-j
unbind C-b

# pane number 表示時間 (C-j)
set -g display-panes-time 3000

# tmuxを256色表示できるようにする
set -g default-terminal screen-256color
set -ga terminal-overrides 'xterm:colors=256'

# status bar
set -g status-right '[%Y-%m-%d(%a) %H:%M]'

# ステータスバーの色を設定する
set -g status-style 'fg=colour192,bg=colour26'

# border
set -g pane-border-lines heavy
set -g pane-border-style 'bg=color237,fg=color172'
set -g pane-active-border-style 'bg=color024,fg=color075'
# フローティングペインだけ、枠の上にタイトルを出す (v3.8 以降)
set -g pane-border-status top-floating

# background
set -g window-style 'bg=color237,fg=color250'
set -g window-active-style 'bg=black,fg=color231'

# popup (v3.2 or later)
# 参考 https://tech.visasq.com/introduce-tmux-powerful-features
bind C-p popup -xC -yC -w90% -h95% -E -d "#{pane_current_path}" '\
  if [ popup = $(tmux display -p -F "#{session_name}") ]; then \
    tmux detach-client ; \
  else \
    tmux attach -c $(tmux display -p -F "#{pane_current_path}") -t popup || tmux new -s popup ; \
  fi \
'

# Claude Code の C-x C-e (外部エディタ) 用
# Claude Code はエディタを起動する前に画面を消すので、消される前の画面をバッファに保存してから C-e を渡す。
# 保存した画面は ~/.local/bin/claude-editor が書き戻す。
# Claude Code のペインは pane_current_command で判定する。
# macOS では実行ファイル名のバージョン番号 (例: 2.1.311)、Linux では argv[0] の claude になる。
# C-x はそのまま渡し、次の 1 キーだけ claude-cx テーブルで受ける (C-e 以外はふつうに処理される)。
bind -n C-x if -F '#{m/r:^([0-9.]+|claude)$,#{pane_current_command}}' \
  'send-keys C-x ; switch-client -T claude-cx' \
  'send-keys C-x'
bind -T claude-cx C-e \
  run-shell 'tmux capture-pane -e -t #{pane_id} -b claude-screen-#{pane_id}' \; send-keys C-e

# clipboard copy (v3.2 or later)
# macOS
if-shell 'uname | grep -q Darwin' \
  "set -sq copy-command 'pbcopy'"

# WSL
if-shell 'grep -qi microsoft /proc/version 2>/dev/null' \
  "set -sq copy-command 'clip.exe'"
