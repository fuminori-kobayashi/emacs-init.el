#!/usr/bin/env bash
# Claude Code のプロンプト編集（C-x C-e）用のエディタ。
# tmux の中ならフローティングペイン（new-pane）で emacs を開き、閉じるまで待つ。
# tmux の外ではそのまま emacs -nw で開く。
#
# 名前に notepad を含めているのは、Claude Code に GUI エディタと判定させるため
# （Claude Code 2.1.312 の本体から読み取った内容）。
# Claude Code はエディタのコマンド名に code、cursor、windsurf、codium、subl、atom、gedit、notepad を
# 含むかで GUI エディタかどうかを判定し、起動前の処理を変える。
# - GUI エディタ: prepareTerminalForHandoff() でマウスやフォーカスの報告を止めるだけで、画面は残る。
# - それ以外: 同じ端末で全画面を使う前提で、enterAlternateScreen() が画面を消してから起動する。
# プロンプトの編集（C-x C-e）では、どちらでもエディタが終わるまで待つ。
# ファイルを開くだけの場面（/memory など）では、GUI エディタは端末から切り離して起動し、終わるのを待たない。
# その場合もフローティングペインは開くが、tmux の外では端末がないので emacs -nw は開けない。

if [[ -z "$TMUX" ]]; then
  exec emacs -nw "$@"
fi

# フローティングペインは Claude のペインの中央に、ペインの半分の大きさで出す。
# 小さすぎると使いにくいので最小 80x20 にし、ウィンドウからはみ出さないように収める。
# new-pane の -x -y -X -Y は枠線を含む外側の大きさと位置で、ウィンドウが基準。
read left top pane_w pane_h win_w win_h <<< "$(tmux display -p -t "$TMUX_PANE" \
  '#{pane_left} #{pane_top} #{pane_width} #{pane_height} #{window_width} #{window_height}')"
(( w = pane_w / 2, w < 80 && (w = 80), w > win_w && (w = win_w) ))
(( h = pane_h / 2, h < 20 && (h = 20), h > win_h && (h = win_h) ))
(( x = left + (pane_w - w) / 2, x + w > win_w && (x = win_w - w), x < 0 && (x = 0) ))
(( y = top + (pane_h - h) / 2, y + h > win_h && (y = win_h - h), y < 0 && (y = 0) ))

# 引数は tmux 経由でシェルに渡るので、エスケープしてから渡す。
# macOS 標準の bash 3.2 でも動くように書く。
printf -v args '%q ' "$@"
read pane pane_pid <<< "$(tmux new-pane -P -F '#{pane_id} #{pane_pid}' \
  -t "$TMUX_PANE" -c "$PWD" -x $w -y $h -X $x -Y $y \
  -T " Claude prompt (${TMUX_PANE#%}) " \
  "emacs -nw $args")"

# new-pane は閉じるのを待たずに戻るので、ペインがなくなるまで待つ。
# Emacs を終了したときだけでなく、ペインごと閉じたとき（kill-pane など）も戻れるように、
# ペインの中の処理に頼らず、tmux にペインがあるかを問い合わせる。
# （存在しないペインを -t で指定しても display は終了コード 0 で、#{pane_id} が空になる）
while [[ $(tmux display -p -t "$pane" '#{pane_id}' 2>/dev/null) == "$pane" ]]; do
  sleep 0.5
done

# ペインごと閉じると、Emacs にはシグナルが届かず、端末がないまま動き続ける。残っていれば止める。
if ps -o command= -p "$pane_pid" 2>/dev/null | grep -q emacs; then
  pkill -HUP -P "$pane_pid"
  kill -HUP "$pane_pid"
fi
tmux select-pane -t "$TMUX_PANE"
